# Copy this file to .env and fill it in. Never commit .env.

# 1 = sample output, no Langflow call (use this to check the UI).
# 0 = call your real Langflow flow.
STUB=1

LANGFLOW_URL=http://127.0.0.1:7860
# The id in the flow's address: .../flow/<this-id>
LANGFLOW_FLOW_ID=
# Only needed if your Langflow requires an API key. Keep it in this file, not in the browser.
LANGFLOW_API_KEY=

# Optional limits
MAX_CHARS=200000
REQUEST_TIMEOUT=300
